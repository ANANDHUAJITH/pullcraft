<plot title="Five-Tier Pagoda" description="Stacked tiers with curved roofs.">
  <let name="wood" value="dark_oak_planks"/>
  <let name="tile" value="red_concrete"/>
  <box x="4" y="0" z="4" w="24" h="1" d="24" block="stone_bricks"/>
  <group x="8" y="1" z="8">
    <walls x="0" y="0" z="0" w="16" h="5" d="16" block="$wood"/>
    <pyramid x="-2" y="5" z="-2" w="20" h="3" d="20" block="$tile"/>
  </group>
  <group x="10" y="9" z="10">
    <walls x="0" y="0" z="0" w="12" h="4" d="12" block="$wood"/>
    <pyramid x="-2" y="4" z="-2" w="16" h="3" d="16" block="$tile"/>
  </group>
  <group x="12" y="16" z="12">
    <walls x="0" y="0" z="0" w="8" h="4" d="8" block="$wood"/>
    <pyramid x="-2" y="4" z="-2" w="12" h="3" d="12" block="$tile"/>
  </group>
  <group x="14" y="23" z="14">
    <walls x="0" y="0" z="0" w="4" h="3" d="4" block="$wood"/>
    <pyramid x="-2" y="3" z="-2" w="8" h="3" d="8" block="$tile"/>
    <box x="1" y="6" z="1" w="2" h="5" d="2" block="gold_block"/>
  </group>
  <box x="14" y="1" z="8" w="4" h="3" d="1" block="air"/>
</plot>
