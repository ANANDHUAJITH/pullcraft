<plot title="Glass Needle" description="A 48-floor tower with a crown and antenna. Written in XML.">
  <let name="frame" value="iron_block"/>
  <let name="pane" value="tinted_glass"/>
  <box x="6" y="0" z="6" w="20" h="1" d="20" block="smooth_stone"/>
  <group x="10" y="1" z="10">
    <shell x="0" y="0" z="0" w="12" h="48" d="12" block="$pane"/>
    <box x="0" y="0" z="0" w="12" h="1" d="12" block="$frame" repeat-y="12" gap-y="3"/>
    <box x="0" y="0" z="0" w="1" h="48" d="1" block="$frame" repeat-x="2" gap-x="10" repeat-z="2" gap-z="10"/>
    <dome x="1" y="48" z="1" w="10" h="5" d="10" block="sea_lantern"/>
    <box x="5" y="53" z="5" w="2" h="9" d="2" block="$frame"/>
  </group>
</plot>
